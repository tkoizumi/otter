# Build context for the runtime image.
# NOTE: `bin/` is deliberately NOT ignored — the Dockerfile COPYs the
# pre-built otterd/otter binaries out of it. Run `make build` first.

.git
.gitignore
tmp
.cache
.gocache
dist
**/__pycache__
**/*.py[cod]
*.db
*.db-wal
*.db-shm
*.egg-info
.venv
venv
.DS_Store
.idea
.vscode
docs
*.md
Makefile
