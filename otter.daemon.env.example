# Daemon-wide settings for `otter deploy` (--daemon-env).
#
# Copy this to otter.daemon.env and edit it. `otter deploy` uploads the file to
# /etc/otter/workspaces/<workspace>.daemon.env, which the generated unit loads
# with EnvironmentFile=; the daemon applies it to its own environment, and a
# job receives only the values its manifest declares.
#
# The file is gitignored (*.env), because everything here reaches the daemon's
# environment and an API token or a notification URL is a credential. Keep this
# example credential-free.

# How many child processes the daemon runs at once, across every job.
#
# The default is one worker per CPU core, capped at eight. On a small host that
# default is wrong: otterd and every Python child share one systemd cgroup, and
# a plain deploy caps that cgroup at MemoryMax=75% of RAM. On the 1 GiB Castor
# host (2 vCPU, 904 MiB) two workers plus the daemon cross that ceiling, so the
# kernel OOM-kills a run. One worker is the right value there.
#
# Budget workers x peak Python RSS against available RAM before raising it.
OTTER_WORKERS=1

# Structured logs for journald. Leave the rest of the defaults alone unless
# there is a reason to change them.
#OTTER_LOG_FORMAT=json
#OTTER_LOG_LEVEL=info

# How long a run may take to shut down before the daemon gives up on it. A
# deploy's restart waits up to TimeoutStopSec in the unit for this to finish.
#OTTER_SHUTDOWN_GRACE=30s

# Failure notifications (see docs/operations.md). Free-form; the format decides
# how the payload is encoded.
#OTTER_NOTIFY_URL=https://hooks.example.com/services/XXX
#OTTER_NOTIFY_ON=failures
#OTTER_NOTIFY_FORMAT=slack
