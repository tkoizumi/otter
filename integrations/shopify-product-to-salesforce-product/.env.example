# Copy to /etc/otter/shopify-product-to-salesforce-product.env (mode 0600, owned
# by the otter user) and point the daemon at it:
#
#   systemd:  EnvironmentFile=/etc/otter/shopify-product-to-salesforce-product.env
#   shell:    set -a; . /etc/otter/shopify-product-to-salesforce-product.env; set +a
#
# Locally, `make sync-up` reads ./otter.env, so copy this file there instead.
#
# These are read from the DAEMON's environment. Otter validates the four
# required ones before starting Python and never exposes them through the API
# or `otter inspect`. Do not commit this file.

# --- required: Shopify ------------------------------------------------------
# From the Dev Dashboard: your app -> Settings -> Client ID / Client secret.
# The integration exchanges these for a 24 hour access token on every run via
# the client credentials grant. There is no token to copy out of the Shopify
# admin, and no long-lived token to rotate.
#
# These credentials identify the *app*, which may act on every store in its
# organization; the one store this integration reads is named by SHOPIFY_STORE
# in otter.yaml.
SHOPIFY_CLIENT_ID=replace_me
SHOPIFY_CLIENT_SECRET=replace_me

# --- required: Salesforce ---------------------------------------------------
# Connected app with the Client Credentials flow enabled and a "Run As" user
# that can read and write Product2.
SALESFORCE_CLIENT_ID=replace_me
SALESFORCE_CLIENT_SECRET=replace_me

# --- optional ---------------------------------------------------------------

# Only if you still hold a pre-generated Shopify token, e.g. from a legacy
# admin-created custom app. When set it is used verbatim and the client
# credentials grant is skipped -- in that case you may drop SHOPIFY_CLIENT_ID
# and SHOPIFY_CLIENT_SECRET from the `secrets:` list in otter.yaml.
#SHOPIFY_ACCESS_TOKEN=shpat_replace_me

# Only for SALESFORCE_AUTH=password. SALESFORCE_PASSWORD is the account
# password with the security token appended. If you use these, add them to the
# `secrets:` list in otter.yaml so a missing value fails fast.
#SALESFORCE_USERNAME=integration@example.com
#SALESFORCE_PASSWORD=replace_me

# --- operational knobs (defaults shown) -------------------------------------
# Override here rather than editing the committed manifest. These are the
# settings.py knobs; the non-secret targets they refer to -- SHOPIFY_STORE,
# SALESFORCE_INSTANCE_URL, SALESFORCE_OBJECT and SALESFORCE_EXTERNAL_ID_FIELD --
# live in otter.yaml instead.
#PAGE_SIZE=100
#MAX_PAGES_PER_RUN=20
#RUN_BUDGET_SECONDS=240
#OVERLAP_SECONDS=600
#BACKFILL_FROM=2026-01-01T00:00:00Z
#BACKFILL_DAYS=30
# Set to 1 for a read-only rehearsal that writes nothing and does not advance
# the watermark.
#DRY_RUN=0

# --- client settings --------------------------------------------------------
# Salesforce records per composite call; 1 forces per-record writes. Read by
# otter_connectors.clients rather than settings.py, as is the Shopify API
# version -- both are properties of the client, not of the sync.
#SALESFORCE_BATCH_SIZE=200
#
# The remaining client settings are in otter.yaml: SHOPIFY_API_VERSION,
# SALESFORCE_API_VERSION and SALESFORCE_AUTH. Two more exist only to point the
# Shopify client somewhere other than the live API in a test or a proxy:
# SHOPIFY_API_BASE and SHOPIFY_TOKEN_URL.
