# Copy to /etc/otter/shopify-to-salesforce.env (mode 0600, owned by the otter
# user) and point the daemon at it:
#
#   systemd:  EnvironmentFile=/etc/otter/shopify-to-salesforce.env
#   shell:    set -a; . /etc/otter/shopify-to-salesforce.env; set +a
#   docker:   docker run --env-file /etc/otter/shopify-to-salesforce.env ...
#
# These are read from the DAEMON's environment. Otter validates the four
# required ones before starting Python and never exposes them through the API
# or `otter inspect`. Do not commit this file.

# --- required: Shopify ------------------------------------------------------
# From the Dev Dashboard: your app -> Settings -> Client ID / Client secret.
# The integration exchanges these for a 24 hour access token on every run via
# the client credentials grant. There is no token to copy out of the Shopify
# admin, and no long-lived token to rotate.
SHOPIFY_CLIENT_ID=bdf7e0f25c36b788ac4afc4199d46fdd
SHOPIFY_CLIENT_SECRET=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

# --- required: Salesforce ---------------------------------------------------
# Connected app with the Client Credentials flow enabled and a "Run As" user
# that can read and write Contacts.
SALESFORCE_CLIENT_ID=3MVG9U65ySgtae710r2XRvups4FmfSZ9LMau14udDFYsnDFCSm1Dpb8td9dfHft6XWnjUBLdJIfYBFGxPtQ5q
SALESFORCE_CLIENT_SECRET=BA1D8E0A893E0CB38AFA26CE0A5C91EDC4CCAF58F91BCB4953D0AA58C1BDCA1B

# --- optional ---------------------------------------------------------------

# Only if you still hold a pre-generated Shopify token, e.g. from a legacy
# admin-created custom app. When set it is used verbatim and the client
# credentials grant is skipped -- in that case you may drop SHOPIFY_CLIENT_ID
# and SHOPIFY_CLIENT_SECRET from the `secrets:` list in otter.yaml.
#SHOPIFY_ACCESS_TOKEN=shpat_replace_me

# Only for SALESFORCE_AUTH=password. SALESFORCE_PASSWORD is the account
# password with the security token appended. If you use these, add them to the
# `secrets:` list in otter.yaml so a missing value fails fast.
#SALESFORCE_USERNAME=integration@example.com
#SALESFORCE_PASSWORD=hunter2SECURITYTOKEN

# --- operational knobs (defaults shown) -------------------------------------
# Override here rather than editing the committed manifest.
#PAGE_SIZE=100
#MAX_PAGES_PER_RUN=20
#RUN_BUDGET_SECONDS=240
#OVERLAP_SECONDS=600
#SALESFORCE_BATCH_SIZE=200
#SYNC_ADDRESS=1
# Set to 1 for a read-only rehearsal that writes nothing and does not advance
# the watermark.
#DRY_RUN=0
#SHOPIFY_SORT_KEY=UPDATED_AT
