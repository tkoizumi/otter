# Build output
bin/
dist/

# Local runtime data (SQLite database, extracted SDK, logs)
tmp/
*.db
*.db-wal
*.db-shm

# Deploy state: which host this checkout last deployed to, and its API token.
# Never commit either file.
.otter/

# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/

# Tool caches
.cache/
.gocache/

# Runtime configuration at the repository root. Both are ignored by the *.env
# rule below; named without a leading dot so they stay visible, because they are
# configuration an operator has to find and edit. Credentials live in otter.env
# shared by every integration, rather than one file per integration, so
# rotating a credential is one edit instead of N.
otter.daemon.env
otter.env

# Secrets: real credentials live in the daemon's environment, never here.
# .env.example is committed; .env files are not.
.env
*.env
!*.env.example

# Editors / OS
.DS_Store
.idea/
.vscode/
