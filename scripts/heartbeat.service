# Otter dead-man's-switch heartbeat — systemd service.
#
# Install beside heartbeat.timer:
#
#   sudo install -m 0755 scripts/heartbeat.sh /usr/local/lib/otter/heartbeat.sh
#   sudo install -m 0644 scripts/heartbeat.service /etc/systemd/system/
#   sudo install -m 0644 scripts/heartbeat.timer   /etc/systemd/system/
#   sudo install -d -m 0750 /etc/otter
#   printf 'OTTER_HEARTBEAT_URL=https://hc-ping.com/<uuid>\n' |
#       sudo tee /etc/otter/heartbeat.env >/dev/null
#   sudo chmod 0640 /etc/otter/heartbeat.env
#   sudo systemctl daemon-reload && sudo systemctl enable --now otter-heartbeat.timer
#
# The URL lives in an EnvironmentFile rather than in this unit so it is not
# world-readable, and so a deploy can change it without editing a file systemd
# owns.
#
# There is deliberately no OnFailure= that raises its own alert: this host
# cannot be trusted to report its own death, which is the whole point of the
# switch. A missing ping is the alarm, and it is raised by the external service.
[Unit]
Description=Otter dead-man's-switch heartbeat
Documentation=https://github.com/tkoizumi/otter
After=otterd.service

[Service]
Type=oneshot
User=otter
Group=otter
EnvironmentFile=/etc/otter/heartbeat.env
ExecStart=/usr/local/lib/otter/heartbeat.sh
# A failed run stays in the journal and in `systemctl --failed`, so an operator
# inspecting a silent host can see whether the runtime or the check was at fault.
